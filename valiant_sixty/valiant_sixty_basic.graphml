      <data key="d5">1669</data>
      <data key="d6">Appleby Gaol, Westmorland, England</data>
      <data key="d7">QUAKER</data>
      <data key="d8">Preacher and Writer</data>
      <data key="d9">Throughout Britain</data>
      <data key="d10">https://en.wikipedia.org/wiki/Francis_Howgill</data>
      <data key="d11">https://www.quaker.org.uk/</data>
      <data key="d12">lightsteelblue</data>
      <data key="d13">2</data>
      <data key="d14">box</data>
      <data key="d15">Francis Howgill\n(1618-1669)\nQUAKER Preacher</data>
    </node>
    
    <!-- James Nayler (Valiant Sixty Member) -->
    <node id="james_nayler">
      <data key="d0">James Nayler</data>
      <data key="d1">Person</data>
      <data key="d2">Valiant Sixty Member</data>
      <data key="d3">1618</data>
      <data key="d4">Ardsley, Yorkshire, England</data>
      <data key="d5">1660</data>
      <data key="d6">King's Ripton, Huntingdonshire, England</data>
