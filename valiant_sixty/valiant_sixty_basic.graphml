      <data key="d10">https://en.wikipedia.org/wiki/James_Nayler</data>
      <data key="d11">https://www.quaker.org.uk/</data>
      <data key="d12">lightsteelblue</data>
      <data key="d13">2</data>
      <data key="d14">box</data>
      <data key="d15">James Nayler\n(1618-1660)\nQUAKER Preacher</data>
    </node>
    
    <!-- George Whitehead (Valiant Sixty Member) -->
    <node id="george_whitehead">
      <data key="d0">George Whitehead</data>
      <data key="d1">Person</data>
      <data key="d2">Valiant Sixty Member</data>
      <data key="d3">1636</data>
