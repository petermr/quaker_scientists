      <data key="d15">Elizabeth Hooton\n(c.1600-1672)\nQUAKER Preacher</data>
    </node>
    
    <!-- Example: Valiant Sixty Member (Template) -->
    <node id="example_member">
      <data key="d0">[Member Name]</data>
      <data key="d1">Person</data>
      <data key="d2">Valiant Sixty Member</data>
      <data key="d3">[Birth Date]</data>
      <data key="d4">[Birth Place]</data>
      <data key="d5">[Death Date]</data>
      <data key="d6">[Death Place]</data>
      <data key="d7">QUAKER</data>
      <data key="d8">[Occupation]</data>
      <data key="d9">[Primary Ministry Area]</data>
      <data key="d10">[Wikipedia URL]</data>
      <data key="d11">[Quaker.org.uk URL]</data>
      <data key="d12">lightsteelblue</data>
      <data key="d13">2</data>
      <data key="d14">box</data>
      <data key="d15">[Member Name]\n([Birth-Death])\nQUAKER Missionary</data>
    </node>
    
    <!-- Example: Meeting House (Place) -->
    <node id="swarthmoor_hall">
      <data key="d0">Swarthmoor Hall</data>
      <data key="d1">Place</data>
      <data key="d2">Meeting House</data>
      <data key="d3"></data>
      <data key="d4">Ulverston, Lancashire, England</data>
      <data key="d5"></data>
      <data key="d6"></data>
      <data key="d7">QUAKER</data>
      <data key="d8"></data>
      <data key="d9">Lancashire</data>
      <data key="d10">https://en.wikipedia.org/wiki/Swarthmoor_Hall</data>
      <data key="d11">https://www.quaker.org.uk/</data>
      <data key="d12">lightgray</data>
      <data key="d13">2</data>
      <data key="d14">diamond</data>
      <data key="d15">Swarthmoor Hall\nQUAKER Meeting House</data>
    </node>
    
    <!-- Example: Event -->
    <node id="example_event">
      <data key="d0">[Event Name]</data>
      <data key="d1">Event</data>
      <data key="d2">[Event Type]</data>
      <data key="d3">[Event Date]</data>
      <data key="d4">[Event Location]</data>
      <data key="d5"></data>
      <data key="d6"></data>
      <data key="d7">QUAKER</data>
      <data key="d8"></data>
      <data key="d9"></data>
      <data key="d10">[Wikipedia URL if available]</data>
      <data key="d11">[Quaker.org.uk URL if available]</data>
      <data key="d12">orange</data>
      <data key="d13">2</data>
      <data key="d14">diamond</data>
      <data key="d15">[Event Name]\n[Date]</data>
    </node>
    
    <!-- Example Relationships -->
    
    <!-- George Fox to Margaret Fell (Marriage) -->
    <edge id="fox_fell_marriage" source="george_fox" target="margaret_fell">
      <data key="e0">spouse</data>
      <data key="e1">1669</data>
      <data key="e2"></data>
      <data key="e3">Married in 1669</data>
      <data key="e4">https://en.wikipedia.org/wiki/George_Fox</data>
      <data key="e5">married</data>
    </edge>
    
    <!-- George Fox to Edward Burrough (Mentor) -->
    <edge id="fox_burrough_mentor" source="george_fox" target="edward_burrough">
      <data key="e0">mentor</data>
      <data key="e1">1652</data>
      <data key="e2"></data>
      <data key="e3">George Fox converted and mentored Edward Burrough</data>
      <data key="e4">https://en.wikipedia.org/wiki/Edward_Burrough</data>
      <data key="e5">mentor</data>
    </edge>
    
    <!-- George Fox to Mary Fisher (Mentor) -->
    <edge id="fox_fisher_mentor" source="george_fox" target="mary_fisher">
      <data key="e0">mentor</data>
